{
  "id": null,
  "uid": "anomaly-middleware",
  "title": "Middleware IA - Détection d'anomalies microservices",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-5m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Traces analysées",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "count_over_time({job=\"anomaly-middleware\"}[$__range])"
        }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 2,
      "title": "Anomalies (vérité terrain)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"anomaly-middleware\"} | json ground_truth_label=\"ground_truth_label\" | ground_truth_label=\"1\" [$__range]))"
        }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 3,
      "title": "Anomalies détectées (LogBERT)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"anomaly-middleware\"} | json semantic_detected=\"semantic_detected\" | semantic_detected=\"true\" [$__range]))"
        }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 4,
      "title": "Cascades détectées (GAT)",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"anomaly-middleware\"} | json cascade_detected=\"cascade_detected\" | cascade_detected=\"true\" [$__range]))"
        }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "dark-red" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 5,
      "title": "Latence d'inférence réelle (ms) - LogBERT + GAT",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 16, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "legendFormat": "latence moyenne",
          "expr": "avg_over_time({job=\"anomaly-middleware\"} | json total_latency_ms=\"total_latency_ms\" | unwrap total_latency_ms [$__interval])"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "legendFormat": "latence p95",
          "expr": "quantile_over_time(0.95, {job=\"anomaly-middleware\"} | json total_latency_ms=\"total_latency_ms\" | unwrap total_latency_ms [$__interval])"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 6,
      "title": "Stress moyen par service (fenêtre visible)",
      "type": "bargauge",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "legendFormat": "Gateway",
          "expr": "avg_over_time({job=\"anomaly-middleware\"} | json stress_gateway=\"stress_gateway\" | unwrap stress_gateway [$__range])"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "legendFormat": "Order",
          "expr": "avg_over_time({job=\"anomaly-middleware\"} | json stress_order=\"stress_order\" | unwrap stress_order [$__range])"
        },
        {
          "refId": "C",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "legendFormat": "Payment",
          "expr": "avg_over_time({job=\"anomaly-middleware\"} | json stress_payment=\"stress_payment\" | unwrap stress_payment [$__range])"
        },
        {
          "refId": "D",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "legendFormat": "Inventory",
          "expr": "avg_over_time({job=\"anomaly-middleware\"} | json stress_inventory=\"stress_inventory\" | unwrap stress_inventory [$__range])"
        },
        {
          "refId": "E",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "legendFormat": "Shipping",
          "expr": "avg_over_time({job=\"anomaly-middleware\"} | json stress_shipping=\"stress_shipping\" | unwrap stress_shipping [$__range])"
        }
      ],
      "fieldConfig": {
        "defaults": { "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 0.3 },
          { "color": "red", "value": 0.6 }
        ] } },
        "overrides": []
      },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 7,
      "title": "Flux des traces anormales (temps réel)",
      "type": "logs",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "expr": "{job=\"anomaly-middleware\"} | json ground_truth_label=\"ground_truth_label\" | ground_truth_label=\"1\""
        }
      ],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true }
    }
  ]
}
